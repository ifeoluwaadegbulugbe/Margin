rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.xp == 0 && request.resource.data.level == 1;
      allow update: if isOwner(uid)
        && request.resource.data.xp >= resource.data.xp                 // XP never decreases
        && request.resource.data.xp - resource.data.xp <= 1000;         // sanity cap per write
      allow delete: if false;

      match /xpLedger/{tx} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.amount is number
          && request.resource.data.amount > 0 && request.resource.data.amount <= 200;
        allow update, delete: if false;                                  // append-only
      }
      match /achievements/{a} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
      // Explicit list: a recursive wildcard here would also match xpLedger/achievements
      // and silently re-allow updates/deletes there (Firestore grants if ANY rule allows).
      match /{sub}/{docId} {
        allow read, write: if isOwner(uid)
          && sub in ['sessions', 'mastery', 'misconceptions', 'insights', 'missions', 'variants'];
      }
    }
  }
}
